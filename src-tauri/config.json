  "projects": [
    {
      "id": "payment_service",
      "name": "Payment Gateway Service",
      "description": "Эквайринг и обработка платежей",
      "resources": [
        {
          "id": "gitlab_repo",
          "name": "GitLab: payment-core",
          "type": "http_status",
          "target": "https://gitlab.bank.local/payments/core",
          "expected_codes": [
            200,
            401
          ],
          "responsible_team": "DevOps",
          "request_template": "Прошу предоставить доступ на чтение/запись в GitLab репозиторий 'payments/core'."
        },
        {
          "id": "jira_board",
          "name": "Jira: PAYM Project",
          "type": "http_status",
          "target": "https://jira.bank.local/projects/PAYM",
          "expected_codes": [
            200,
            302
          ],
          "responsible_team": "PMO",
          "request_template": "Прошу предоставить доступ к Jira проекту 'PAYM' (Payment Gateway)."
        },
        {
          "id": "dev_db",
          "name": "PostgreSQL Dev DB",
          "type": "tcp_port",
          "target": "10.20.4.15:5432",
          "expected_codes": null,
          "responsible_team": "DBA",
          "request_template": "Прошу открыть сетевой доступ к БД PostgreSQL Dev (10.20.4.15:5432)."
        }
      ]
    },
    {
      "id": "core_banking",
      "name": "Core Banking System",
      "description": "Основная банковская платформа",
      "resources": [
        {
          "id": "cbs_api",
          "name": "CBS REST API",
          "type": "http_status",
          "target": "https://cbs.bank.local/api/health",
          "expected_codes": [
            200
          ],
          "responsible_team": "Core Banking Team",
          "request_template": "Прошу предоставить доступ к REST API Core Banking System."
        },
        {
          "id": "cbs_db",
          "name": "Oracle CBS DB",
          "type": "tcp_port",
          "target": "10.20.1.10:1521",
          "expected_codes": null,
          "responsible_team": "DBA",
          "request_template": "Прошу открыть сетевой доступ к Oracle БД Core Banking (10.20.1.10:1521)."
        },
        {
          "id": "cbs_docs",
          "name": "Confluence: CBS Docs",
          "type": "http_status",
          "target": "https://confluence.bank.local/display/CBS",
          "expected_codes": [
            200,
            302
          ],
          "responsible_team": "Tech Docs",
          "request_template": "Прошу предоставить доступ к документации CBS в Confluence."
        }
      ]
    }
